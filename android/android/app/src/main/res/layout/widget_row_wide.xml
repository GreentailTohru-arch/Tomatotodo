<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/row_root" android:layout_width="match_parent" android:layout_height="42dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/row_leading" android:layout_width="48dp" android:layout_height="wrap_content" android:textSize="12sp" android:fontFamily="sans-serif-medium"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/row_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/row_trailing" android:layout_width="54dp" android:layout_height="wrap_content" android:textSize="11sp" android:gravity="end" android:maxLines="2" android:ellipsize="end" android:layout_marginStart="6dp"/>
</LinearLayout>
